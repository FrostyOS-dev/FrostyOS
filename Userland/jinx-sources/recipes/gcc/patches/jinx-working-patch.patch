diff -ruN gcc-clean/gcc/config.gcc gcc-dirty/gcc/config.gcc
--- gcc-clean/gcc/config.gcc	2025-08-08 16:51:40.435347488 +1000
+++ gcc-dirty/gcc/config.gcc	2026-05-29 18:02:55.175570299 +1000
@@ -1172,6 +1172,14 @@
   *) ;;
   esac
   ;;
+*-*-frostyos*)
+  extra_options="$extra_options gnu-user.opt"
+  gas=yes
+  gnu_ld=yes
+  default_use_cxa_atexit=yes
+  use_gcc_stdint=provide
+  thread_file='posix'
+  ;;
 esac
 
 # Figure out if we need to enable heap trampolines by default
@@ -1959,6 +1966,10 @@
 i[34567]86-*-elf*)
 	tm_file="${tm_file} i386/unix.h i386/att.h elfos.h newlib-stdint.h i386/i386elf.h"
 	;;
+x86_64-*-frostyos*)	
+	tm_file="${tm_file} i386/unix.h i386/att.h elfos.h glibc-stdint.h i386/i386elf.h i386/x86-64.h gnu-user.h frostyos.h"
+	native_system_header_dir="/data/include"
+	;;
 x86_64-*-elf*)
 	tm_file="${tm_file} i386/unix.h i386/att.h elfos.h newlib-stdint.h i386/i386elf.h i386/x86-64.h"
 	;;
