source_hostdeps="autoconf automake libtool"
hostdeps="xgcc xbinutils"
deps="base gmp mpfr"

prepare() {
    autoreconf -vfi
}

configure() {
    ${source_dir}/configure --host=x86_64-frostyos --prefix=/data
}

build() {
    make -j${parallelism}
}

package() {
    make install DESTDIR="${dest_dir}"
}
