name=bash
version=5.3
revision=1
imagedeps="build-essential"
tarball_url="https://ftpmirror.gnu.org/gnu/bash/bash-${version}.tar.gz"
tarball_sha512=426702c8b0fb9e0c9956259973ce5b657890fd47f4f807a64febf20077bb48d0b91474ed6e843d2ef277186b46c5fffa79b808da9b48d4ec027d5e2de1b28ed8
hostdeps="xbinutils xgcc"
deps="base"

prepare() {
	true
}

configure() {
    CFLAGS="-g -fcommon" ${source_dir}/configure --host=x86_64-frostyos --prefix=/data --without-bash-malloc --disable-nls --disable-readline bash_cv_getcwd_malloc=yes gl_cv_func_getcwd_path_max=yes
}

build() {
    make -j ${parallelism}
}

package() {
    make install DESTDIR=${dest_dir}

    pushd ${dest_dir}/data/bin
    ln -sv bash sh
    popd
}
