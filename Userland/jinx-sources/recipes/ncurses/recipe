name=ncurses
version=6.3
revision=1
tarball_url="https://ftpmirror.gnu.org/gnu/ncurses/ncurses-${version}.tar.gz"
tarball_sha512=5373f228cba6b7869210384a607a2d7faecfcbfef6dbfcd7c513f4e84fbd8bcad53ac7db2e7e84b95582248c1039dcfc7c4db205a618f7da22a166db482f0105
imagedeps="build-essential"
hostdeps="xgcc xbinutils libstdc++-v3 libtool"
deps="base"

configure() {
    cf_cv_type_of_bool=bool ${source_dir}/configure --host=x86_64-frostyos --prefix=${prefix} --with-shared --without-normal --with-termlib --disable-widec
}

build() {
    make -j${parallelism}
}

package() {
    make install DESTDIR="${dest_dir}"
    cp ${dest_dir}${prefix}/lib/libncurses.so ${dest_dir}${prefix}/lib/libcurses.so
}
