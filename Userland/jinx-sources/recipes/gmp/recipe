name=gmp
version=6.2.1
revision=1
tarball_url="https://ftp.gnu.org/gnu/gmp/gmp-${version}.tar.xz"
tarball_sha512=c99be0950a1d05a0297d65641dd35b75b74466f7bf03c9e8a99895a3b2f9a0856cd17887738fa51cf7499781b65c049769271cbcb77d057d2e9f1ec52e07dd84
source_imagedeps="build-essential m4"
imagedeps="build-essential m4"
source_hostdeps="autoconf automake libtool"
hostdeps="xgcc xbinutils"
deps="base"

prepare() {
    autoreconf -vfi
}

configure() {
    CFLAGS="-std=gnu17" ${source_dir}/configure --host=x86_64-frostyos --prefix=/data --enable-alloca=malloc-reentrant
}

build() {
    make -j${parallelism}
}

package() {
    make install DESTDIR="${dest_dir}"
    find "${dest_dir}/data" -name "*.la" -type f -exec sed -i "s/^dependency_libs=.*/dependency_libs=''/" {} +
}
