name=xgcc
version=15.2.0
revision=2
from_source=gcc
imagedeps="build-essential libmpfr-dev libmpc-dev libgmp-dev"
hostdeps="automake autoconf xbinutils"
deps="mlibc-headers"

configure() {
    ${source_dir}/configure --target=x86_64-frostyos --prefix=${prefix} --with-sysroot=${sysroot} --enable-languages=c,c++ --enable-threads=posix --disable-multilib --enable-shared --enable-host-shared --with-pic CXXFLAGS="-fno-char8_t"
}

build() {
    make -j${parallelism} all-gcc all-target-libgcc
}

package() {
    make install-gcc install-target-libgcc DESTDIR="${dest_dir}"
}
