name=xbinutils
version=2.45.1
revision=2
from_source=binutils
imagedeps="build-essential gcc"
hostdeps="automake autoconf"

configure() {
    ${source_dir}/configure --target=x86_64-frostyos --prefix=${prefix} --with-sysroot=${sysroot} --disable-nls --disable-werror --enable-shared --disable-gdb --enable-default-execstack=no
}

build() {
    make -j${parallelism}
}

package() {
    make install DESTDIR="${dest_dir}"
}
