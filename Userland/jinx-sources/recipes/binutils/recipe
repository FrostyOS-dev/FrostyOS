name=binutils
version=2.45.1
revision=1
tarball_url="https://ftpmirror.gnu.org/binutils/binutils-${version}.tar.xz"
tarball_sha512=ea030419eba387579ab717be7e3223fc99e93b586860b06003c12489f93441640d4082736f76aa5e98233db4f46e232f536a45e471486de1f5b64e1b827c167e
source_hostdeps="autoconf automake"
source_imagedeps="m4"
imagedeps="build-essential"
hostdeps="xgcc xbinutils automake autoconf"
deps="base"

prepare() {
    (cd ld && automake)
}

configure() {
    ${source_dir}/configure --host=x86_64-frostyos --target=x86_64-frostyos --prefix=/data --disable-werror --enable-default-execstack=no
}

build() {
    make -j${parallelism} tooldir=/data
}

package() {
    make install DESTDIR="${dest_dir}" tooldir=/data
}
