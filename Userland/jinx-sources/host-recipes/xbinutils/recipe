name=xbinutils
version=2.45.1
revision=1
tarball_url="https://ftpmirror.gnu.org/binutils/binutils-${version}.tar.xz"
tarball_sha512=ea030419eba387579ab717be7e3223fc99e93b586860b06003c12489f93441640d4082736f76aa5e98233db4f46e232f536a45e471486de1f5b64e1b827c167e
imagedeps="build-essential"

configure() {
    ${source_dir}/configure --target=x86_64-frostyos --prefix=${prefix} --with-sysroot=${sysroot} --disable-nls --disable-werror --enable-shared --disable-gdb --enable-default-execstack=no
}

build() {
    make -j${parallelism}
}

package() {
    make install DESTDIR="${dest_dir}"
}
